{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ote:pack:manifest:v1",
  "title": "OTE pack manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "kind", "canvas", "frames"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "author": {"type": "string", "maxLength": 120, "default": ""},
    "version": {"type": "string", "minLength": 1, "maxLength": 40, "default": "1.0"},
    "kind": {"enum": ["FINGERPRINT", "AOD"]},
    "description": {"type": "string", "maxLength": 4000, "default": ""},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "height": {"type": "integer", "minimum": 1, "maximum": 4096},
        "anchorX": {"type": ["number", "null"], "minimum": 0},
        "anchorY": {"type": ["number", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"anchorX": {"type": "number"}}, "required": ["anchorX"]},
          "then": {"required": ["anchorY"], "properties": {"anchorY": {"type": "number"}}}
        },
        {
          "if": {"properties": {"anchorY": {"type": "number"}}, "required": ["anchorY"]},
          "then": {"required": ["anchorX"], "properties": {"anchorX": {"type": "number"}}}
        }
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 240,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "durationMs", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\.[pP][nN][gG]$"},
          "durationMs": {"type": "integer", "minimum": 5, "maximum": 10000},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdkMin": {"type": "integer", "minimum": 23, "maximum": 99, "default": 33},
        "sdkMax": {"type": ["integer", "null"], "minimum": 23, "maximum": 99},
        "models": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "profile": {"type": ["string", "null"], "maxLength": 80}
      }
    },
    "thumbnail": {"type": ["string", "null"], "maxLength": 240}
  },
  "$comment": "Runtime additionally enforces safe relative paths, unique frame paths, finite paired anchors within canvas, area/frame/timeline budgets, SDK order, exact declared ZIP contents, PNG structure and SHA-256. This is not a publisher signature."
}
